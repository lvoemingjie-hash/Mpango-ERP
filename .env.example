# =============================================================================
# Mpango ERP — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# =============================================================================

# =============================================================================
# Frontend (Vite build-time variables)
# =============================================================================
VITE_API_URL=http://localhost:8000

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
# TWO-ROLE DB AUTHORITY: DATABASE_URL binds the RUNTIME role only.  It is the
# HOST-SIDE setup connection (setup phase 5 and the tenant bootstrap run on
# the host and must use the loopback published-port form, e.g.
# 127.0.0.1:$POSTGRES_PUBLISHED_PORT - NOT the Compose service DNS name,
# which only resolves inside the container network).  The admin and migration
# credentials below are consumed ONLY by setup phases 1-3 (provision /
# migrate / grants) and are unset again before the runtime starts - they
# must never be reused as the application identity.
DATABASE_URL=postgresql://mpango_app:CHANGE_ME_APP@postgres:5432/mpango_erp  # pragma: allowlist secret
# CONTAINER CONTEXT (injected into the rendered backend service).  The host
# DATABASE_URL above carries the SAME role/database/password identity; in a
# real setup .env its host:port is the loopback published-port translation
# of this service-DNS form - preflight proves the mapping exactly):
DATABASE_URL_CONTAINER=postgresql://mpango_app:CHANGE_ME_APP@postgres:5432/mpango_erp  # pragma: allowlist secret
REDIS_URL_CONTAINER=redis://redis:6379/0

# Migration authority (owns public schema + the shared ledger guard; runs Alembic)
MPANGO_DB_MIGRATE_URL=postgresql://mpango_migrate:CHANGE_ME_MIGRATE@postgres:5432/mpango_erp  # pragma: allowlist secret
MPANGO_DB_MIGRATE_PASSWORD=CHANGE_ME_MIGRATE
# Runtime role password (must equal the password embedded in DATABASE_URL)
MPANGO_DB_APP_PASSWORD=CHANGE_ME_APP

# PostgreSQL administrator credentials (used by docker-compose and provision
# phase 1).  POSTGRES_DB is the MAINTENANCE database (administrator only,
# normally postgres); the application database above (mpango_erp) is NEVER
# pre-created by compose — provisioning phase 1 creates it owned by the
# migration authority, and an existing wrong-owner database refuses.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
MPANGO_DB_ADMIN_URL=postgresql://postgres:CHANGE_ME@postgres:5432/postgres  # pragma: allowlist secret
# Optional: override the loopback-only published ports (docker-compose.yml binds to 127.0.0.1 only)
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379

# =============================================================================
# Security Configuration (REQUIRED)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Mpango ERP
ENVIRONMENT=production
MPANGO_ENV=production
DEBUG=false

# Reporting user (used by BI materialized view migrations)
REPORTING_USER_PASSWORD=CHANGE_ME

# =============================================================================
# CORS Configuration
# =============================================================================
# CORS_ORIGINS is handled by pydantic-settings default in core/config.py
# If needed, set as JSON: CORS_ORIGINS=["http://localhost:3000"]

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Email Delivery Configuration
# =============================================================================
# Production must use SMTP. Do not use dev sink in production.
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=mailer@example.invalid
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.invalid
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# Docker Compose Overrides (optional)
# =============================================================================
# GATEWAY_PORT=80
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=20
# DB_CONNECT_TIMEOUT=10
# REQUEST_TIMEOUT_SECONDS=30
# SLOW_QUERY_THRESHOLD_MS=100
# DEFAULT_TENANT_SCHEMA=t_dev

# DC-12A-R2: Public frontend URL for credential email links
# Production: must be HTTPS (e.g. https://app.mpango.io)
# Local/dev: may be HTTP localhost (e.g. http://localhost:5173)
# PUBLIC_FRONTEND_URL=https://app.example.com
