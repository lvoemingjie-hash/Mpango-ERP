# =============================================================================
# Mpango ERP Production Environment Variables
# =============================================================================
# IMPORTANT: This file contains SENSITIVE credentials!
# - Never commit this file to version control
# - Set restrictive permissions: chmod 600 prod.env
# - Update all SECRET values before first deployment
# =============================================================================

# =============================================================================
# Database Configuration (REQUIRED)
# =============================================================================
# Use asyncpg driver for async SQLAlchemy performance
DATABASE_URL=postgresql+asyncpg://mpango:CHANGE_STRONG_PASSWORD@postgres:5432/mpango_erp

# PostgreSQL credentials (used by docker-compose.yml)
POSTGRES_USER=mpango
POSTGRES_PASSWORD=CHANGE_THIS_STRONG_PASSWORD

# =============================================================================
# Security Configuration (REQUIRED)
# =============================================================================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=your-64-character-secret-key-here-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# JWT configuration
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# Application Configuration
# =============================================================================
APP_NAME=Mpango ERP
ENVIRONMENT=production
DEBUG=false

# =============================================================================
# CORS Configuration
# =============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# Redis Configuration (Optional - for future caching)
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# Logging Configuration
# =============================================================================
LOG_LEVEL=INFO
