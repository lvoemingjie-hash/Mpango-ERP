{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mpango/harness-governance/waivers.schema.json",
  "title": "Mpango ERP harness governance temporary waivers",
  "description": "Temporary, owned, dated exceptions to the inventory-sync rule. An expired waiver is a RED state; waivers live in git history only, so an expired entry must be removed or renewed, never parked.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["waiver_id", "scope", "reason", "owner", "risk", "expires"],
    "properties": {
      "waiver_id": { "type": "string", "pattern": "^WVR-[A-Z0-9]+(-[A-Z0-9]+)*$", "minLength": 5 },
      "scope": { "enum": ["inventory-sync"] },
      "reason": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "risk": { "type": "string", "minLength": 1 },
      "expires": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "paths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
      "date_opened": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "notes": { "type": "string" }
    }
  }
}
