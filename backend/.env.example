# Mpango ERP Backend Configuration
# Copy this file to .env and fill in the values
#
# S2-1 COMPLIANCE: All REQUIRED fields must be set in production.
# The application will CRASH on startup if production secrets are missing or using defaults.

# =============================================================================
# ENVIRONMENT (REQUIRED) - S2-1
# =============================================================================
# Must be either "production" or "test"
# - production: Enforces strict validation, requires non-default secrets
# - test: Allows default values for local development
MPANGO_ENV=test

# =============================================================================
# DATABASE (REQUIRED) - S2-1
# =============================================================================
# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database  # pragma: allowlist secret
#
# PRODUCTION: Must NOT use default credentials
# TEST/DEV: Can use default for local development
# Runtime role connection (application + tenant bootstrap).  Must NOT name
# the migration authority or the postgres administrator (single-role setups
# are rejected by setup preflight and by the bootstrap authority gate).
DATABASE_URL=postgresql://mpango_app:mpango_app_dev@localhost:5432/mpango_erp  # pragma: allowlist secret
DATABASE_ECHO=false

# CONTAINER CONTEXT (what the rendered backend service receives — the Compose
# service DNS names; preflight proves it binds the same identity as the host
# DATABASE_URL above, translated only to the service name):
DATABASE_URL_CONTAINER=postgresql://mpango_app:mpango_app_dev@postgres:5432/mpango_erp  # pragma: allowlist secret
REDIS_URL_CONTAINER=redis://redis:6379/0

# Compose interpolation keys (setup.sh passes this file to docker compose as
# its env-file; the administrator password is consumed by the postgres
# container init and provisioning phase 1 and must equal the password in
# MPANGO_DB_ADMIN_URL):
POSTGRES_PASSWORD=postgres_admin_dev
POSTGRES_PUBLISHED_PORT=5432
REDIS_PUBLISHED_PORT=6379

# Two-role DB authority (setup-time only; unset before the runtime starts).
# The admin URL targets the MAINTENANCE database (normally postgres); the
# migration/runtime URLs target the APPLICATION database (mpango_erp).  These
# keys must NEVER be added to a rendered backend service environment —
# setup_preflight refuses them there.
MPANGO_DB_ADMIN_URL=postgresql://postgres:postgres_admin_dev@localhost:5432/postgres  # pragma: allowlist secret
MPANGO_DB_MIGRATE_URL=postgresql://mpango_migrate:mpango_migrate_dev@localhost:5432/mpango_erp  # pragma: allowlist secret
MPANGO_DB_MIGRATE_PASSWORD=mpango_migrate_dev
MPANGO_DB_APP_PASSWORD=mpango_app_dev

# =============================================================================
# REDIS (REQUIRED) - S2-1
# =============================================================================
# Redis connection string for caching and sessions
# Format: redis://host:port/db
#
# PRODUCTION: Must NOT use localhost
# TEST/DEV: Can use default for local development
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# SECURITY (REQUIRED) - S2-1 & S2.5
# =============================================================================
# JWT Secret Key - MUST be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# S2.5 SECURITY REQUIREMENTS:
# - Minimum 32 characters
# - Must NOT contain weak substrings: secret, default, password, 123456, change-me, admin, test, demo
# - Use cryptographically secure random key
# - Application will CRASH on startup if key is weak
#
# PRODUCTION: Must be a strong random key
# TEST/DEV: Can use default for local development (but still must be 32+ chars and no weak substrings)
SECRET_KEY=EXAMPLE_ONLY_REPLACE_WITH_python_c_import_secrets_secrets_token_urlsafe_32

# JWT Algorithm (HS256 recommended)
ALGORITHM=HS256

# Token expiration settings
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME=Mpango ERP
DEBUG=false

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
# Update this for your frontend URLs
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# =============================================================================
# MULTI-TENANCY
# =============================================================================
# Default tenant schema for development
DEFAULT_TENANT_SCHEMA=t_dev

# =============================================================================
# R1-R6: PUBLIC FRONTEND ORIGIN (explicit required runtime input)
# =============================================================================
# Absolute HTTPS origin used to build credential-email links. The initial
# setup preflight validates this value (and the identical value rendered into
# the Compose backend service) BEFORE any side effect; production Settings
# re-validates it at application import. Production requires HTTPS and an
# origin only: no credentials, path, query, or fragment (a single trailing
# slash is accepted and stripped).
PUBLIC_FRONTEND_URL=https://app.example.com

# =============================================================================
# EMAIL DELIVERY
# =============================================================================
# Production must use SMTP. Do not use dev_sink in production.
EMAIL_PROVIDER=smtp
EMAIL_DELIVERY_MODE=smtp
SMTP_HOST=smtp.example.invalid
SMTP_PORT=587
SMTP_USER=mailer@example.invalid
SMTP_PASSWORD=
EMAIL_FROM=no-reply@example.invalid
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# =============================================================================
# OPERATIONAL SETTINGS
# =============================================================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=30

# Database connection pool settings
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_CONNECT_TIMEOUT=10

# =============================================================================
# FEATURE FLAGS
# =============================================================================
ENABLE_METRICS=false
ENABLE_REQUEST_LOGGING=true

# =============================================================================
# S2-1 PRODUCTION CHECKLIST
# =============================================================================
# Before deploying to production, ensure:
#
# ✅ MPANGO_ENV=production
# ✅ DATABASE_URL points to production database (not localhost)
# ✅ REDIS_URL points to production Redis (not localhost)
# ✅ SECRET_KEY is a secure random string (min 32 chars)
# ✅ All default passwords have been changed
# ✅ CORS_ORIGINS contains only your production frontend URLs
# ✅ DEBUG=false
# ✅ This .env file is NOT committed to git (check .gitignore)
#
# The application will CRASH on startup if these requirements are not met.


# =============================================================================
# S6-P: REPORTING / BI FOUNDATION
# =============================================================================
# Separate database connection for read-only reporting queries.
# reporting_user (member of reporting_role) has:
#   - SELECT-only permissions (public + tenant reporting objects)
#   - 30s statement_timeout
#   - default_transaction_read_only = on
#
# R1-R7: the reporting engine requires an EXPLICIT runtime DSN.  There is no
# fallback: the reporting URL is never derived from DATABASE_URL, and the
# setup-only REPORTING_USER_PASSWORD must NEVER appear in the rendered
# backend environment (the initial preflight refuses it by key).
#
# Setup-only (migration 011 consumes it to create reporting_user):
# REPORTING_USER_PASSWORD=<setup-time secret>
#
# Runtime (REQUIRED by the backend service; container context only).  The
# decoded password must EQUAL REPORTING_USER_PASSWORD so the migration-created
# login and the runtime reporting connection cannot drift - the initial
# preflight proves this before any side effect.  Replace the URL-encoded
# placeholder below with the URL-encoded value of REPORTING_USER_PASSWORD:
REPORTING_DATABASE_URL_CONTAINER=postgresql://reporting_user:%7BREPORTING_USER_PASSWORD_URL_ENCODED%7D@postgres:5432/mpango_erp

# =============================================================================
# S3-A: SQL PROFILING & PERFORMANCE
# =============================================================================
# Enable SQL query profiling and performance tracking
# Tracks query count, duration, and identifies slow queries
ENABLE_SQL_PROFILING=true

# Threshold in milliseconds for slow query warnings
# Queries exceeding this threshold will be logged as WARNING
# Default: 100ms
SLOW_QUERY_THRESHOLD_MS=100
