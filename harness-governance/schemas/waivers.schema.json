{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mpango/harness-governance/waivers.schema.json",
  "title": "Mpango ERP harness governance temporary waivers",
  "description": "Temporary, owned, dated, path-scoped exceptions to the semantic sync rule. Fail-closed: paths are required and explicit (no wildcards, no repo root, no implicit global exemption); the union of all active waivers must cover every exempted changed path; governance-core paths are never waivable. An expired waiver is RED; waivers live in git history only, so an expired entry must be removed or renewed, never parked.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "waiver_id",
      "scope",
      "reason",
      "owner",
      "risk",
      "approval_ref",
      "opened_on",
      "expires_on",
      "paths"
    ],
    "properties": {
      "waiver_id": { "type": "string", "pattern": "^WVR-[A-Z0-9]+(-[A-Z0-9]+)*$", "minLength": 5 },
      "scope": { "enum": ["inventory-sync"] },
      "reason": { "type": "string", "minLength": 1 },
      "owner": { "type": "string", "minLength": 1 },
      "risk": { "enum": ["P0", "P1", "P2", "P3"] },
      "approval_ref": { "type": "string", "minLength": 1 },
      "opened_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "expires_on": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
      "paths": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "minLength": 2 }
      },
      "notes": { "type": "string" }
    }
  }
}
