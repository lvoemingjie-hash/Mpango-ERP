{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HE2-ET1 authority profiles",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1$"
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "profile_id",
          "description",
          "required_traps",
          "phases",
          "runner",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "profile_id": {
            "type": "string",
            "pattern": "^AUTHORITY_[A-Z0-9_]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "required_traps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^TRAP_[A-Z0-9_]+$"
            }
          },
          "phases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "runner": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "ACTIVE",
              "RETIRED"
            ]
          }
        }
      }
    }
  }
}
